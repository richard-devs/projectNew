<div class="unh-home">

  <header class="unh-site-header">

    <div class="unh-topbar">
      <div class="container unh-header-inner">

        <div class="unh-branding">
          {{ page.header_branding }}
        </div>

        <div class="unh-account">
          {{ page.header }}
        </div>

      </div>
    </div>

    {% if page.primary_menu %}
      <nav class="unh-navigation">
        <div class="container">
          {{ page.primary_menu }}
        </div>
      </nav>
    {% endif %}

  </header>


  <main>

    {% if page.featured_top %}
      <section class="unh-hero">
        <div class="container">
          {{ page.featured_top }}
        </div>
      </section>
    {% endif %}


    {% if page.featured_bottom_first %}
      <section class="unh-section unh-section-light">
        <div class="container">
          {{ page.featured_bottom_first }}
        </div>
      </section>
    {% endif %}


    {% if page.featured_bottom_second %}
      <section class="unh-section">
        <div class="container">
          {{ page.featured_bottom_second }}
        </div>
      </section>
    {% endif %}


    {% if page.featured_bottom_third %}
      <section class="unh-section unh-section-light">
        <div class="container">
          {{ page.featured_bottom_third }}
        </div>
      </section>
    {% endif %}


    {% if page.highlighted %}
      <section class="unh-section">
        <div class="container">
          {{ page.highlighted }}
        </div>
      </section>
    {% endif %}

  </main>


  <footer class="unh-footer">

    <div class="container">

      <div class="unh-footer-grid">

        <div>
          {{ page.footer_first }}
        </div>

        <div>
          {{ page.footer_second }}
        </div>

        <div>
          {{ page.footer_third }}
        </div>

        <div>
          {{ page.footer_fourth }}
        </div>

      </div>

      <div class="unh-footer-bottom">
        {{ page.footer_fifth }}
      </div>

    </div>

  </footer>

</div>

{{ page.page_bottom }}
