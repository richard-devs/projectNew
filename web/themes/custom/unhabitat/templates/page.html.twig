<header class="unh-site-header">

  <div class="unh-topbar">
    <div class="container unh-header-inner">

      <div class="unh-branding">
        {{ page.header_branding }}
      </div>

      {% if page.header %}
        <div class="unh-account">
          {{ page.header }}
        </div>
      {% endif %}

    </div>
  </div>

  {% if page.primary_menu %}
    <nav class="unh-navigation">
      <div class="container">
        {{ page.primary_menu }}
      </div>
    </nav>
  {% endif %}

</header>

<main class="unh-main">

  {% if page.breadcrumb %}
    <div class="unh-breadcrumb">
      <div class="container">
        {{ page.breadcrumb }}
      </div>
    </div>
  {% endif %}

  <div class="container">

    {% if page.highlighted %}
      <div class="unh-highlighted">
        {{ page.highlighted }}
      </div>
    {% endif %}

    <div class="unh-content-layout">

      <section class="unh-content" id="main-content">

        {% if path('<current>') in ['/ops/projects', '/ops/tasks'] %}
          <div class="ops-projects-dashboard-link">
            <a href="/ops/dashboard">← Back to ICTS Dashboard</a>
          </div>
        {% endif %}

        {{ page.content }}
      </section>

      {% if page.sidebar_first %}
        <aside class="unh-sidebar">
          {{ page.sidebar_first }}
        </aside>
      {% endif %}

      {% if page.sidebar_second %}
        <aside class="unh-sidebar">
          {{ page.sidebar_second }}
        </aside>
      {% endif %}

    </div>

  </div>

</main>

<footer class="unh-footer">

  <div class="container">

    <div class="unh-footer-grid">

      <div>{{ page.footer_first }}</div>
      <div>{{ page.footer_second }}</div>
      <div>{{ page.footer_third }}</div>
      <div>{{ page.footer_fourth }}</div>

    </div>

    {% if page.footer_fifth %}
      <div class="unh-footer-bottom">
        {{ page.footer_fifth }}
      </div>
    {% endif %}

  </div>

</footer>

{{ page.page_bottom }}
