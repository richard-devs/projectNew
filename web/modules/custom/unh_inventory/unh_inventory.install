        ],
        'entity_id' => [
          'description' => 'Entity ID.',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'uid' => [
          'description' => 'User who performed the action.',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'created' => [
          'description' => 'Unix timestamp when the activity occurred.',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'action' => [
          'description' => 'Activity action.',
          'type' => 'varchar',
          'length' => 64,
          'not null' => TRUE,
        ],
        'field_name' => [
          'description' => 'Machine name of the changed field.',
          'type' => 'varchar',
          'length' => 128,
          'not null' => FALSE,
        ],
        'old_value' => [
          'description' => 'Previous value.',
          'type' => 'text',
          'size' => 'big',
          'not null' => FALSE,
        ],
        'new_value' => [
          'description' => 'New value.',
          'type' => 'text',
          'size' => 'big',
          'not null' => FALSE,
        ],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'entity' => ['entity_type', 'entity_id'],
        'created' => ['created'],
        'uid' => ['uid'],
      ],
    ]);

    return 'Created the ICTS Ops activity log table.';
  }

  return 'The ICTS Ops activity log table already exists.';
}
