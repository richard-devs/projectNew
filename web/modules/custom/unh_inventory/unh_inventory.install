      ],
      'field_name' => [
        'description' => 'Machine name of the changed field.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'old_value' => [
        'description' => 'Previous value.',
        'type' => 'text',
