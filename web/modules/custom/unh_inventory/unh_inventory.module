
<?php

/**
 * Add a dedicated body class to the ICTS asset creation page.
 */
function unh_inventory_preprocess_page(array &$variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();

  if ($route_name === 'node.add' && \Drupal::routeMatch()->getParameter('node_type') === 'icts_asset') {
    $variables['attributes']['class'][] = 'page-icts-asset-create';
  }
}


/**
 * Returns the controlled ICTS Department / Division options.
 */
function unh_inventory_department_options() {
  return [
    'Global Solutions Division (GSD)' => 'Global Solutions Division (GSD)',
    'Global Knowledge & Advocacy Division (GKAD)' => 'Global Knowledge & Advocacy Division (GKAD)',
    'Regional Programmes Division (RPD)' => 'Regional Programmes Division (RPD)',
    'Corporate Management Division (CMD)' => 'Corporate Management Division (CMD)',
    'Office of the Executive Director (OED)' => 'Office of the Executive Director (OED)',
    'Unspecified' => 'Unspecified',
  ];
}


/**
 * Adds navigation to ICTS Ops task and project detail pages.
 */
function unh_inventory_node_view(array &$build, \Drupal\node\NodeInterface $node, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display, $view_mode) {
  if (!in_array($node->bundle(), ['ops_task', 'ops_project'], TRUE)) {
    return;
  }

  $is_task = $node->bundle() === 'ops_task';
  $list_path = $is_task ? '/ops/tasks' : '/ops/projects';

  $build['ops_detail_navigation'] = [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['ops-detail-tabs'],
    ],
    '#weight' => -99,
    'overview' => [
      '#type' => 'link',
      '#title' => 'Overview',
      '#url' => \Drupal\Core\Url::fromRoute('entity.node.canonical', [
        'node' => $node->id(),
      ]),
      '#attributes' => [
        'class' => ['ops-detail-tab', 'is-active'],
      ],
    ],
    'activity' => [
      '#type' => 'link',
      '#title' => 'Activity / History',
      '#url' => \Drupal\Core\Url::fromRoute('unh_inventory.ops_activity', [
        'node' => $node->id(),
      ]),
      '#attributes' => [
        'class' => ['ops-detail-tab'],
      ],
    ],
  ];

  $build['back_to_list'] = [
    '#type' => 'link',
    '#title' => $is_task ? '← Back to Tasks' : '← Back to Projects',
    '#url' => \Drupal\Core\Url::fromUserInput($list_path),
    '#weight' => -100,
    '#attributes' => [
      'class' => [$is_task ? 'back-to-tasks' : 'back-to-projects'],
    ],
  ];
}





/**
 * Automatically records only fields actually changed through
 * the ICTS asset edit form.
 */
function unh_inventory_node_presave(\Drupal\node\NodeInterface $node) {







  /*
   * ICTS Inventory device change logging.
   */
  if ($node->bundle() === 'icts_asset' && !$node->isNew()) {
    $original = $node->getOriginal();

    if ($original) {
      foreach ($node->getFieldDefinitions() as $field_name => $definition) {
        /*
         * Track the Drupal title because it is the Device Name / Hostname.
         * Also track the custom ICTS Inventory fields.
         */
        if ($field_name !== 'title' && strpos($field_name, 'field_asset_') !== 0) {
          continue;
        }

        /*
         * Assignment and status have their own dedicated activity
         * logging and must not be duplicated here.
         */
        if (in_array($field_name, [
          'field_asset_status',
          'field_asset_assigned_to',
          'field_asset_notes',
        ], TRUE)) {
          continue;
        }

        if (!$original->hasField($field_name)) {
          continue;
        }

        $old_value = $field_name === 'title'
          ? trim(strip_tags((string) $original->label()))
          : unh_inventory_get_device_history_value($original, $field_name);

        $new_value = $field_name === 'title'
          ? trim(strip_tags((string) $node->label()))
          : unh_inventory_get_device_history_value($node, $field_name);

        /*
         * Only record a real value change.
         * This also captures intentional clearing of a field.
         */
        if ($old_value === $new_value) {
          continue;
        }

        $logged_new_value = $new_value;

        $field_label = $field_name === 'title'
          ? 'Device Name / Hostname'
          : (string) $definition->getLabel();

        unh_inventory_log_inventory_activity(
          'changed',
          'inventory_device',
          $node->id(),
          $node->label(),
          $field_name,
          $field_label,
          $old_value,
          $logged_new_value
        );
      }
    }

    return;
  }

  if (!in_array($node->bundle(), ['ops_project', 'ops_task'], TRUE)) {
    return;
  }

  $field = $node->bundle() === 'ops_project'
    ? 'field_project_owner'
    : 'field_task_assignee';

  $assigned_by = $node->bundle() === 'ops_project'
    ? 'field_project_assigned_by'
    : 'field_task_assigned_by';

  if (!$node->isNew() && isset($node->original)) {
    $old_assignment = $node->original->get($field)->target_id ?? NULL;
    $new_assignment = $node->get($field)->target_id ?? NULL;

    if ($new_assignment && $new_assignment !== $old_assignment) {
      $node->set($assigned_by, [
        'target_id' => \Drupal::currentUser()->id(),
      ]);
    }
  }

  if ($node->isNew() || !isset($node->original)) {
    return;
  }

  foreach ($node->getFieldDefinitions() as $field_name => $definition) {
    if (in_array($field_name, [
      'nid',
      'vid',
      'type',
      'uuid',
      'langcode',
      'revision_timestamp',
      'revision_uid',
      'revision_log',
      'revision_default',
      'status',
      'uid',
      'created',
      'changed',
      'path',
      'promote',
      'sticky',
      'default_langcode',
      'revision_translation_affected',
      'field_project_assigned_by',
      'field_task_assigned_by',
    ], TRUE)) {
      continue;
    }

    if (!$node->original->hasField($field_name)) {
      continue;
    }

    $old_values = $node->original->get($field_name)->getValue();
    $new_values = $node->get($field_name)->getValue();

    if ($old_values !== $new_values) {
      $old_value = unh_inventory_get_field_history_value(
        $node->original,
        $field_name
      );

      $new_value = unh_inventory_get_field_history_value(
        $node,
        $field_name
      );

      unh_inventory_log_activity(
        $node,
        'changed',
        $field_name,
        $old_value,
        $new_value
      );
    }
  }
}

/**
 * Implements hook_node_insert().
 *
 * Logs creation of ICTS Ops projects and tasks.
 */
function unh_inventory_node_insert(\Drupal\node\NodeInterface $node) {
  if ($node->bundle() === 'icts_asset') {
    $device_type = unh_inventory_get_device_history_value(
      $node,
      'field_asset_device_type'
    );

    $asset_tag = unh_inventory_get_device_history_value(
      $node,
      'field_asset_tag'
    );

    $details = $asset_tag ? 'Asset ID: ' . $asset_tag : '—';

    $notes = '';
    if ($node->hasField('field_asset_notes') && !$node->get('field_asset_notes')->isEmpty()) {
      $notes = trim(strip_tags((string) $node->get('field_asset_notes')->value));
    }

    if ($notes !== '') {
      $details .= ' | Reason: ' . $notes;
    }

    unh_inventory_log_inventory_activity(
      'device_added',
      'inventory_device',
      $node->id(),
      $node->label(),
      'field_asset_device_type',
      $device_type ?: 'Unknown device type',
      NULL,
      $details
    );

    return;
  }

  if (!in_array($node->bundle(), ['ops_project', 'ops_task'], TRUE)) {
    return;
  }

  unh_inventory_log_activity(
    $node,
    'created',
    NULL,
    NULL,
    NULL
  );
}

/**
 * Logs deletion of an ICTS Inventory device.
 */
function unh_inventory_node_delete(\Drupal\node\NodeInterface $node) {
  if ($node->bundle() !== 'icts_asset') {
    return;
  }

  unh_inventory_log_inventory_activity(
    'device_deleted',
    'inventory_device',
    $node->id(),
    $node->label()
  );
}

/**
 * Returns a human readable field value for activity history.
 */
function unh_inventory_get_field_history_value(
  \Drupal\node\NodeInterface $node,
  string $field_name
): ?string {
  if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
    return NULL;
  }

  $field = $node->get($field_name);
  $definition = $field->getFieldDefinition();
  $type = $definition->getType();

  if ($type === 'entity_reference') {
    $entity = $field->entity;
    return $entity ? $entity->label() : NULL;
  }

  $value = $field->value;

  if ($value === NULL || $value === '') {
    return NULL;
  }

  if ($type === 'list_string') {
    $allowed_values = $definition->getSetting('allowed_values') ?: [];

    if (isset($allowed_values[$value])) {
      return (string) $allowed_values[$value];
    }
  }

  if ($type === 'datetime') {
    try {
      $date = new \DateTime($value);
      return $date->format('d M Y, H:i');
    }
    catch (\Exception $e) {
      return $value;
    }
  }

  return (string) $value;
}

/**
 * Stores an ICTS Ops activity record.
 */
function unh_inventory_log_activity(
  \Drupal\node\NodeInterface $node,
  string $action,
  ?string $field_name,
  ?string $old_value,
  ?string $new_value
): void {
  static $logged = [];

  $key = implode('|', [
    $node->id(),
    $action,
    $field_name ?? '',
    $old_value ?? '',
    $new_value ?? '',
  ]);

  if (isset($logged[$key])) {
    return;
  }

  $logged[$key] = TRUE;

  \Drupal::database()->insert('unh_ops_activity')
    ->fields([
      'entity_type' => 'node',
      'entity_id' => $node->id(),
      'uid' => \Drupal::currentUser()->id(),
      'created' => \Drupal::time()->getRequestTime(),
      'action' => $action,
      'field_name' => $field_name,
      'old_value' => $old_value,
      'new_value' => $new_value,
    ])
    ->execute();
}


